<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.view.CarrinhoController" prefHeight="400" prefWidth="500">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <Label text="Resumo do Pedido" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <ListView fx:id="listaItensCarrinho" VBox.vgrow="ALWAYS" />

    <Label fx:id="labelTotalFinal" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <Label fx:id="labelStatus" style="-fx-font-size: 14px; -fx-text-fill: green;" />

    <HBox spacing="10.0" alignment="CENTER">
        <Button text="Voltar ao Catálogo" onAction="#handleVoltar" />
        <Button fx:id="botaoFinalizar" text="Confirmar e Finalizar Pedido" onAction="#handleFinalizar" style="-fx-font-size: 14px; -fx-background-color: #28a745; -fx-text-fill: white;" />
    </HBox>
</VBox>